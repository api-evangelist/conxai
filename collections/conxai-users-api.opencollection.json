{
  "opencollection": "1.0.0",
  "info": {
    "name": "Customer annotations users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get users by project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "//customer.conxai.ai/users/:projectId",
            "auth": {
              "type": "apikey",
              "key": "X-Api-Key",
              "value": "{{X-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get users by project id"
        },
        {
          "info": {
            "name": "Remove users from project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "//customer.conxai.ai/users/:projectId/userUuid",
            "auth": {
              "type": "apikey",
              "key": "X-Api-Key",
              "value": "{{X-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Remove users from project by user id"
        },
        {
          "info": {
            "name": "Add user to project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "//customer.conxai.ai/users/add-to-project",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Api-Key",
              "value": "{{X-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Add user to project by email and project id"
        }
      ]
    }
  ],
  "bundled": true
}