          "id": "25da18d5-970c-4e79-ba2a-58c1c8c6f51d",
          "name": "Upload a workflow context document",
          "request": {
            "name": "Upload a workflow context document",
            "description": {
              "content": "This endpoint provides a presigned URL for clients to upload a workflow context document (excel, csv, json) directly to an S3 bucket. In the follow-up PUT request to the presigned URL the file should be the raw binary body of the request. It is important to resend the Content-Type header as well as the Content-Disposition header including the original filename.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":projectId",
                "use-cases",
                ":useCaseId",
                "workflows",
                ":workflowId",
                "workflow-context-document"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) Unique id of the project."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "useCaseId",
                  "description": "(Required) Unique id of the use case."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workflowId",
                  "description": "(Required) Unique id of the workflow_handlers."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Content-Disposition of the document file. Must be attachment; filename=<filename>",
                "key": "Content-Disposition",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"<string>\"\n}",
