            "method": "GET",
            "url": "//customer.conxai.ai/projects/:projectId/use-cases/:useCaseId/document-types",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              },
              {
                "name": "useCaseId",
                "value": "",
                "type": "path",
                "description": "Use Case Id"
              }
            ]
          },
          "docs": "Get document types list for use case"
        },
        {
          "info": {
            "name": "Create a new document types and update schema for existing",
