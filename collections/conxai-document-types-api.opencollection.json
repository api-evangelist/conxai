                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project UUID"
              },
              {
                "name": "useCaseId",
                "value": "",
                "type": "path",
                "description": "Use Case Id"
              },
              {
                "name": "documentTypeId",
                "value": "",
                "type": "path",
                "description": "Document Type Id"
              }
            ]
          },
