          },
          "http": {
            "method": "PUT",
            "url": "//customer.conxai.ai/projects/:projectId/use-cases/:useCaseId/document-types",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Unique id of the project."
              },
              {
                "name": "useCaseId",
                "value": "",
                "type": "path",
                "description": "Unique id of the useCase."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new document types and update schema for existing"
        },
        {
          "info": {
