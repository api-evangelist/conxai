                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Unique id of the project."
              },
              {
                "name": "documentTypeId",
                "value": "",
                "type": "path",
                "description": "Unique id of the document type "
              },
              {
                "name": "useCaseId",
                "value": "",
                "type": "path",
                "description": "Unique id of the use case."
              }
            ]
          },
          "docs": "Delete a documents type by ID"
        },
        {
          "info": {
            "name": "Get document type by uuid (latest version)",
